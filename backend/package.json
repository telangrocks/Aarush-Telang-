{
  "name": "crypto-pulse-backend",
  "version": "1.0.0",
  "description": "Backend API for Crypto Pulse, running on Cloudflare Workers.",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.js",
    "clean-install": "rm -rf node_modules package-lock.json && npm cache clean --force && npm install",
    "test": "vitest run src",
    "test:watch": "vitest src",
    "test:coverage": "vitest run src --coverage",
    "test:smoke": "node scripts/smoke-test.js",
    "test:ccxt": "tsx scripts/test-ccxt-connectivity.ts",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Aarush Telang",
  "license": "UNLICENSED",
  "dependencies": {
    "@hono/node-server": "^1.11.1",
    "bignumber.js": "^11.1.5",
    "ccxt": "4.5.69",
    "dotenv": "^17.4.2",
    "hono": "^4.4.12",
    "protobufjs": "^7.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260728.1",
    "@types/bignumber.js": "^4.0.3",
    "@types/node": "^20.14.9",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "eslint": "^8.57.0",
    "prettier": "^3.3.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.2",
    "vitest": "^1.6.0",
    "wrangler": "^4.110.0"
  }
}
